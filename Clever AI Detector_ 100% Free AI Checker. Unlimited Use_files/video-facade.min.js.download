document.addEventListener("DOMContentLoaded",(function(){document.querySelectorAll(".video-facade").forEach((function(e){e.addEventListener("click",(function(){const t=document.createElement("iframe");t.src="https://www.youtube.com/embed/"+e.dataset.videoId+"?autoplay=1",t.title=e.getAttribute("aria-label")||"YouTube video player",t.width=560,t.height=315,t.allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share",t.referrerPolicy="strict-origin-when-cross-origin",t.allowFullscreen=!0,e.replaceWith(t)}),{once:!0})}))}));
